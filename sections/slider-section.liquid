{%- liquid
  assign is_slider = false
  if section.blocks.size > 4
    assign is_slider = true
  endif
-%}

{%- style -%}
  .slider-section-{{ section.id }} {
    position: relative;
    width: 100%;
    background-color: #ffeddd; /* Pale Peach */
    box-sizing: border-box;
    font-family: "Helvetica Neue", Arial, sans-serif;
  }

  /* Responsive Spacing from Settings */
  @media screen and (min-width: 769px) {
    .slider-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
  @media screen and (max-width: 768px) {
    .slider-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  /* Inner Container */
  .slider-inner-container-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 769px) {
    .slider-inner-container-{{ section.id }} {
      padding: 0 157px;
    }
  }

  @media screen and (max-width: 768px) {
    .slider-inner-container-{{ section.id }} {
      padding: 0;
    }
  }

  /* Main Inner Box */
  .slider-box-{{ section.id }} {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media screen and (min-width: 769px) {
    .slider-box-{{ section.id }} {
      background-color: #A07636; /* Gold-brown from Figma */
      border-radius: 25px;
      padding: 40px 30px;
      gap: 24px;
      box-shadow: 0px 210px 73px rgba(0,0,0,0.04), 0px 76.653px 26.646px rgba(0,0,0,0.03), 0px 37.214px 12.936px rgba(0,0,0,0.02), 0px 18.243px 6.342px rgba(0,0,0,0.02), 0px 7.213px 2.507px rgba(0,0,0,0.01);
    }
  }

  @media screen and (max-width: 768px) {
    .slider-box-{{ section.id }} {
      background-color: transparent;
      border-radius: 0;
      padding: 56px 19px 0 19px;
      gap: 24px;
      box-shadow: none;
    }
  }

  /* Header Controls */
  .slider-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .slider-title-{{ section.id }} {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.72px;
    margin: 0;
  }

  @media screen and (min-width: 769px) {
    .slider-title-{{ section.id }} {
      color: #FFFFFF;
    }
  }

  @media screen and (max-width: 768px) {
    .slider-title-{{ section.id }} {
      color: #102116;
    }
  }

  /* Navigation Buttons */
  .slider-nav-{{ section.id }} {
    display: none;
    gap: 4px;
    align-items: center;
  }

  @media screen and (min-width: 769px) {
    .slider-nav-{{ section.id }} {
      display: flex;
    }
  }

  .slider-nav-btn-{{ section.id }} {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: none;
    color: #000000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    padding: 0;
  }

  .slider-nav-btn-{{ section.id }} svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }

  .slider-nav-btn-{{ section.id }}:hover:not(:disabled) {
    background-color: #ffeddd;
  }

  .slider-nav-btn-{{ section.id }}:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Carousel Scroll Container */
  .slider-track-wrapper-{{ section.id }} {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .slider-track-wrapper-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  /* Layout Container */
  .slider-track-{{ section.id }} {
    display: flex;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Premium Card Styles inside the section */
  .slider-card-item {
    scroll-snap-align: start;
    flex-shrink: 0;
    width: 264px;
    background-color: #FFFFFF;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000000;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0px 210px 73px rgba(0,0,0,0.04), 0px 76.653px 26.646px rgba(0,0,0,0.03), 0px 37.214px 12.936px rgba(0,0,0,0.02), 0px 18.243px 6.342px rgba(0,0,0,0.02), 0px 7.213px 2.507px rgba(0,0,0,0.01);
  }

  /* Hover states for clickable cards */
  a.slider-card-item:hover {
    transform: translateY(-4px);
  }

  /* Image Box Wrapper */
  .slider-card-image-wrapper {
    position: relative;
    width: 264px;
    height: 336px;
    overflow: hidden;
    background-color: #F8F5F0;
  }

  .slider-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Placeholder Image box */
  .slider-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F3ECE5;
    color: #A07636;
  }

  .placeholder-svg-content {
    width: 50%;
    height: 50%;
    opacity: 0.6;
  }

  /* Content info box */
  .slider-card-content {
    box-sizing: border-box;
    width: 264px;
    height: 129px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 11px;
    background-color: #FFFFFF;
  }

  .slider-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
  }

  /* Tag style */
  .slider-card-tag {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(0, 0, 0, 0.65);
    white-space: nowrap;
  }

  /* Price tag style */
  .slider-card-price {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000000;
  }

  /* Title style */
  .slider-card-title {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: #000000;
    margin: 0;
    letter-spacing: -0.2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Keep non-clickable cards styling clean and disable pointer events */
  div.slider-card-item {
    cursor: default;
  }
{%- endstyle -%}

<div class="slider-section-{{ section.id }}" id="slider-{{ section.id }}">
  <div class="slider-inner-container-{{ section.id }}">
    
    <div class="slider-box-{{ section.id }}">
      
      <!-- Section Header -->
      <div class="slider-header-{{ section.id }}">
        {%- if section.settings.title != blank -%}
          <h2 class="slider-title-{{ section.id }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        
        <!-- Navigation Arrows (Only if blocks count > 4) -->
        {%- if is_slider -%}
          <div class="slider-nav-{{ section.id }}">
            <button class="slider-nav-btn-{{ section.id }} slider-prev-btn" aria-label="Previous Slide" disabled>
              <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
            <button class="slider-nav-btn-{{ section.id }} slider-next-btn" aria-label="Next Slide">
              <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <!-- Slide Cards Track -->
      <div class="slider-track-wrapper-{{ section.id }}">
        <div class="slider-track-{{ section.id }} {% if is_slider %}slider-track-carousel-{{ section.id }}{% else %}slider-track-grid-{{ section.id }}{% endif %}">
          {%- for block in section.blocks -%}
            {%- render 'slider-card', block: block -%}
          {%- endfor -%}
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  (function() {
    function initSlider(sectionId) {
      const container = document.getElementById('slider-' + sectionId);
      if (!container) return;

      const wrapper = container.querySelector('.slider-track-wrapper-' + sectionId);
      const prevBtn = container.querySelector('.slider-prev-btn');
      const nextBtn = container.querySelector('.slider-next-btn');

      if (!wrapper) return;

      // If navigation buttons aren't rendered (blocks <= 4), exit gracefully
      if (!prevBtn || !nextBtn) return;

      function getScrollAmount() {
        const card = wrapper.querySelector('.slider-card-item');
        if (card) {
          const track = container.querySelector('.slider-track-' + sectionId);
          const style = window.getComputedStyle(track);
          const gap = parseInt(style.gap) || 24;
          return card.offsetWidth + gap;
        }
        return 300;
      }

      function updateButtons() {
        const scrollLeft = wrapper.scrollLeft;
        const maxScroll = wrapper.scrollWidth - wrapper.clientWidth;
        
        // Use a small tolerance margin of 10px to account for browser sub-pixel rounding
        prevBtn.disabled = scrollLeft <= 10;
        nextBtn.disabled = scrollLeft >= maxScroll - 10;
      }

      prevBtn.addEventListener('click', function() {
        const scrollAmt = getScrollAmount();
        wrapper.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        const scrollAmt = getScrollAmount();
        wrapper.scrollBy({ left: scrollAmt, behavior: 'smooth' });
      });

      // Synchronize scroll gestures and wheel inputs to toggle button accessibility
      wrapper.addEventListener('scroll', updateButtons, { passive: true });

      // Re-evaluate on window resize
      let resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(updateButtons, 100);
      });

      // Initial execution
      setTimeout(updateButtons, 200);
    }

    // Bind theme page load
    document.addEventListener('DOMContentLoaded', function() {
      initSlider('{{ section.id }}');
    });

    // Handle theme customizer reloads
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initSlider('{{ section.id }}');
      }
    });

    // Handle Shopify Theme Customizer block selects
    document.addEventListener('shopify:block:select', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        const blockId = event.detail.blockId;
        const blockElement = document.querySelector('[data-block-id="' + blockId + '"]');
        const wrapper = document.querySelector('.slider-track-wrapper-{{ section.id }}');
        if (blockElement && wrapper) {
          const offsetLeft = blockElement.offsetLeft - wrapper.offsetLeft;
          wrapper.scrollTo({ left: offsetLeft, behavior: 'smooth' });
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Slider Section",
  "tag": "section",
  "class": "section-slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Name",
      "default": "Tailgate Apparel"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Primary Basics Collection Tee"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$45"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (e.g. New Arrival)",
          "default": "New Arrival"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider Section",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
