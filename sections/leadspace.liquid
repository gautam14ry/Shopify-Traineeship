{%- liquid
  assign card_block = section.blocks | where: 'type', 'card' | first
-%}

{%- style -%}
  .leadspace-section-{{ section.id }} {
    position: relative;
    width: 100%;
    background-color: #ffeddd; /* Pale peach background */
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Responsive Spacing & Minimum Heights */
  @media screen and (min-width: 769px) {
    .leadspace-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      {%- if card_block != blank -%}
        min-height: 876px;
      {%- else -%}
        min-height: 479px;
      {%- endif -%}
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {%- if card_block != blank -%}
        min-height: 704px;
      {%- else -%}
        min-height: 429px;
      {%- endif -%}
    }
  }

  /* Container */
  .leadspace-container-{{ section.id }} {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }
  @media screen and (min-width: 769px) {
    .leadspace-container-{{ section.id }} {
      {%- if card_block != blank -%}
        padding-top: 162px;
        padding-bottom: 80px;
      {%- endif -%}
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-container-{{ section.id }} {
      {%- if card_block != blank -%}
        padding-top: 64px;
        padding-bottom: 56px;
        padding-left: 16px;
        padding-right: 16px;
      {%- endif -%}
    }
  }

  /* Cover Image / Back Box */
  .leadspace-cover-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    overflow: hidden;
  }
  @media screen and (min-width: 769px) {
    .leadspace-cover-{{ section.id }} {
      {%- if card_block != blank -%}
        height: 479px;
      {%- else -%}
        height: 100%;
      {%- endif -%}
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-cover-{{ section.id }} {
      {%- if card_block != blank -%}
        height: 429px;
      {%- else -%}
        height: 100%;
      {%- endif -%}
    }
  }

  .leadspace-cover-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .leadspace-cover-placeholder-{{ section.id }} {
    width: 100%;
    height: 100%;
    background-color: #EADBC8;
    display: block;
  }

  /* Front Box (Card Container) */
  .leadspace-front-box-{{ section.id }} {
    background-color: #102116; /* Dark Green from Figma */
    border-radius: 25px;
    z-index: 2;
    box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.5);
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
    width: 100%;
  }

  @media screen and (min-width: 769px) {
    .leadspace-front-box-{{ section.id }} {
      max-width: 1168px;
      min-height: 634px;
      flex-direction: row;
      align-items: flex-end;
      overflow: visible;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-front-box-{{ section.id }} {
      max-width: 331px;
      min-height: 584px;
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Text Wrapper Inside Card */
  .leadspace-text-col-{{ section.id }} {
    display: flex;
    flex-direction: column;
    color: #FFFFFF;
    box-sizing: border-box;
  }
  @media screen and (min-width: 769px) {
    .leadspace-text-col-{{ section.id }} {
      flex: 1;
      padding: 60px 48px;
      align-items: flex-start;
      justify-content: flex-end;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-text-col-{{ section.id }} {
      padding: 32px 24px 0 24px;
      align-items: flex-start;
    }
  }

  /* Headings & Descriptions */
  .leadspace-heading-{{ section.id }} {
    color: #FFFFFF;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 24px 0;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  @media screen and (min-width: 769px) {
    .leadspace-heading-{{ section.id }} {
      font-size: 120px;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-heading-{{ section.id }} {
      font-size: 68px;
      margin-bottom: 16px;
    }
  }

  .leadspace-desc-{{ section.id }} {
    color: #FFFFFF;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 400;
    margin: 0;
  }
  @media screen and (min-width: 769px) {
    .leadspace-desc-{{ section.id }} {
      font-size: 24px;
      line-height: 1.25;
      max-width: 512px;
      margin-bottom: 32px;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-desc-{{ section.id }} {
      font-size: 18px;
      line-height: 1.3;
      max-width: 280px;
      margin-bottom: 24px;
    }
  }

  /* Shop Now Button (Desktop Inline) */
  .leadspace-btn-{{ section.id }} {
    background-color: #FFFFFF;
    color: #0F2216;
    border-radius: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
    box-sizing: border-box;
    box-shadow: 4px 8px 12px rgba(0, 0, 0, 0.25);
  }
  .leadspace-btn-{{ section.id }}:hover {
    background-color: #F3ECE5;
    transform: translateY(-2px);
  }
  .leadspace-btn-text-{{ section.id }} {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 700;
    text-align: center;
  }
  @media screen and (min-width: 769px) {
    .leadspace-btn-{{ section.id }} {
      display: inline-flex;
      width: 220px;
      height: 52px;
    }
    .leadspace-btn-text-{{ section.id }} {
      font-size: 16px;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-btn-{{ section.id }} {
      display: none;
    }
  }

  /* Front Image Wrapper */
  .leadspace-front-img-box-{{ section.id }} {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }
  @media screen and (min-width: 769px) {
    .leadspace-front-img-box-{{ section.id }} {
      width: 480px;
      height: 625px;
      flex-shrink: 0;
      border-bottom-right-radius: 25px;
      align-self: flex-end;
    }
  }
  @media screen and (max-width: 768px) {
    .leadspace-front-img-box-{{ section.id }} {
      width: 100%;
      height: 340px;
      border-bottom-right-radius: 20px;
      margin-top: auto;
    }
  }

  .leadspace-front-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Front Image Placeholder */
  .leadspace-front-placeholder-{{ section.id }} {
    width: 100%;
    height: 100%;
    background-color: #1a2f22;
    display: block;
  }

  /* Shop Now Button (Mobile Image Overlay) */
  .leadspace-btn-overlay-{{ section.id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #FFFFFF;
    color: #0F2216;
    border-radius: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 4px 8px 12px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, background-color 0.2s ease;
    z-index: 3;
    white-space: nowrap;
    box-sizing: border-box;
    width: 170px;
    height: 48px;
  }
  .leadspace-btn-overlay-{{ section.id }}:hover {
    background-color: #F3ECE5;
    transform: translateX(-50%) translateY(-2px);
  }
  .leadspace-btn-overlay-text-{{ section.id }} {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-weight: 700;
    font-size: 14px;
  }
  @media screen and (min-width: 769px) {
    .leadspace-btn-overlay-{{ section.id }} {
      display: none;
    }
  }
{%- endstyle -%}

<div class="leadspace-section-{{ section.id }}">
  <div class="leadspace-container-{{ section.id }}">
    
    <!-- Cover Image (Back Box) -->
    <div class="leadspace-cover-{{ section.id }}">
      <picture>
        {%- if section.settings.cover_image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.cover_image_mobile | image_url: width: 768 }}">
        {%- elsif section.settings.cover_image_desktop != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.cover_image_desktop | image_url: width: 768 }}">
        {%- endif -%}
        
        {%- if section.settings.cover_image_desktop != blank -%}
          <img 
            src="{{ section.settings.cover_image_desktop | image_url: width: 1440 }}" 
            alt="{{ section.settings.cover_image_desktop.alt | escape }}"
            class="leadspace-cover-img-{{ section.id }}"
            loading="eager"
            width="1440"
            height="479"
          >
        {%- else -%}
          <div class="leadspace-cover-placeholder-{{ section.id }}">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </picture>
    </div>

    <!-- Front Box Card Content -->
    {%- if card_block != blank -%}
      <div class="leadspace-front-box-{{ section.id }}" {{ card_block.shopify_attributes }}>
        
        <!-- Text Content Column -->
        <div class="leadspace-text-col-{{ section.id }}">
          {%- if card_block.settings.title != blank -%}
            <h2 class="leadspace-heading-{{ section.id }}">{{ card_block.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if card_block.settings.description != blank -%}
            <p class="leadspace-desc-{{ section.id }}">{{ card_block.settings.description | escape }}</p>
          {%- endif -%}

          <!-- CTA Button (Renders only if both text and link are present) -->
          {%- if card_block.settings.cta_text != blank and card_block.settings.cta_link != blank -%}
            <a href="{{ card_block.settings.cta_link }}" class="leadspace-btn-{{ section.id }}">
              <span class="leadspace-btn-text-{{ section.id }}">{{ card_block.settings.cta_text | escape }}</span>
            </a>
          {%- endif -%}
        </div>

        <!-- Front Image Column -->
        <div class="leadspace-front-img-box-{{ section.id }}">
          {%- if card_block.settings.image != blank -%}
            <img 
              src="{{ card_block.settings.image | image_url: width: 600 }}" 
              alt="{{ card_block.settings.image.alt | default: card_block.settings.title | escape }}"
              class="leadspace-front-img-{{ section.id }}"
              loading="lazy"
              width="480"
              height="625"
            >
          {%- else -%}
            <div class="leadspace-front-placeholder-{{ section.id }}">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <!-- CTA Button Overlay (Mobile only, renders only if both text and link are present) -->
          {%- if card_block.settings.cta_text != blank and card_block.settings.cta_link != blank -%}
            <a href="{{ card_block.settings.cta_link }}" class="leadspace-btn-overlay-{{ section.id }}">
              <span class="leadspace-btn-overlay-text-{{ section.id }}">{{ card_block.settings.cta_text | escape }}</span>
            </a>
          {%- endif -%}
        </div>

      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Leadspace Section",
  "tag": "section",
  "class": "section-leadspace",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "cover_image_desktop",
      "label": "Cover image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "cover_image_mobile",
      "label": "Cover image (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card Block",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Front Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FALL TRENDS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet. In architecto recusandae et odio quisquam quo corporis."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leadspace Section",
      "blocks": [
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
