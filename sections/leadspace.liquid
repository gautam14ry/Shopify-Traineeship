<style>
  #shopify-section-{{ section.id }} .leadspace {
    padding-top: {{ section.settings.mobile_top_padding }}px;
    padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .leadspace {
      padding-top: {{ section.settings.desktop_top_padding }}px;
      padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
    }
  }

  .leadspace {
    font-family: Helvetica, sans-serif;
    position: relative;
    overflow: hidden;
    background-color: #FFEDDD;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  @media (min-width: 768px) {
    .leadspace {
      padding-right: 136px;
      padding-left: 136px;
    }
  }

  .leadspace__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 55%;
    object-fit: cover;
  }

  .leadspace__card {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
    background-color: #102116;
    border-radius: 25px;
    color: #fff;
    margin: 1rem 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .leadspace__card {
      flex-direction: row;
      margin: 2rem auto;
    }
  }

  .leadspace__card-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .leadspace__card-content {
      padding: 1rem;
      padding-bottom: 1rem;
    }
  }

  .leadspace__card-media {
    flex: 1;
    min-width: 0;
    {% comment %} overflow: hidden; {% endcomment %}
    {% comment %} height: auto; {% endcomment %}
    aspect-ratio: 4/3;
    border-top-right-radius: 25px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
  }

  @media (min-width: 768px) {
    .leadspace__card-media {
      border-top-right-radius: 25px;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 25px;
    }
  }

  .leadspace__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .leadspace__card-title {
    font-size: clamp(2.5rem, 3.1363rem + 7.6263vw, 10rem);
    line-height: 1;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 1rem;
  }

  .leadspace__card-description {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .leadspace__card-description {
      font-size: 1.5rem;
    }
  }

  .leadspace__cta {
    display: inline-block;
    background: #fff;
    color: #000;
    padding: 0.75rem 2rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    max-width: fit-content;
  }
</style>

<div class="leadspace">

  {% if section.settings.desktop_cover_image != blank %}
    <picture>
      {% if section.settings.mobile_cover_image != blank %}
        <source
          media="(max-width: 767px)"
          srcset="{{ section.settings.mobile_cover_image | image_url: width: 750 }}"
        >
      {% endif %}
      {{ section.settings.desktop_cover_image | image_url: width: 1440 | image_tag: class: 'leadspace__background', alt: section.settings.desktop_cover_image.alt }}
    </picture>
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'card' %}
      <div class="leadspace__card" {{ block.shopify_attributes }}>

        <div class="leadspace__card-content">
          {% if block.settings.card_title != blank %}
            <h2 class="leadspace__card-title">
              {{ block.settings.card_title }}
            </h2>
          {% endif %}

          {% if block.settings.card_description != blank %}
            <div class="leadspace__card-description">
              {{ block.settings.card_description }}
            </div>
          {% endif %}

          {% if block.settings.card_cta_text != blank and block.settings.card_cta_link != blank %}
            <a href="{{ block.settings.card_cta_link }}" class="leadspace__cta">
              {{ block.settings.card_cta_text }}
            </a>
          {% endif %}
        </div>

        {% if block.settings.card_image != blank %}
          <div class="leadspace__card-media">
            {{ block.settings.card_image | image_url: width: 600 | image_tag: class: 'leadspace__card-image', alt: block.settings.card_image.alt }}
          </div>
        {% endif %}

      </div>
    {% endif %}
  {% endfor %}

</div>

{% schema %}
{
  "name": "Leadspace",
  "tag": "section",
  "class": "leadspace-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_cover_image",
      "label": "Cover Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_cover_image",
      "label": "Cover Image Mobile"
    },
    {
      "type": "number",
      "id": "desktop_top_padding",
      "label": "Desktop Top Padding",
      "default": 40
    },
    {
      "type": "number",
      "id": "desktop_bottom_padding",
      "label": "Desktop Bottom Padding",
      "default": 40
    },
    {
      "type": "number",
      "id": "mobile_top_padding",
      "label": "Mobile Top Padding",
      "default": 20
    },
    {
      "type": "number",
      "id": "mobile_bottom_padding",
      "label": "Mobile Bottom Padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "inline_richtext",
          "id": "card_title",
          "label": "Card Title"
        },
        {
          "type": "richtext",
          "id": "card_description",
          "label": "Card Description"
        },
        {
          "type": "text",
          "id": "card_cta_text",
          "label": "CTA text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "card_cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leadspace"
    }
  ]
}
{% endschema %}