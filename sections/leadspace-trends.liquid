{%- style -%}
  .leadspace-{{ section.id }} {
    position: relative;
    width: 100%;
    background-color: #FFEDDD;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 704px;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} {
      background-color: #f5ede4;
      min-height: 876px;
    }
  }

  .leadspace-{{ section.id }} .ls-bg-photo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 429px;
    z-index: 0;
    overflow: hidden;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-bg-photo {
      height: 479px;
    }
  }

  .leadspace-{{ section.id }} .ls-bg-photo picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .leadspace-{{ section.id }} .ls-bg-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .leadspace-{{ section.id }} .ls-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-content {
      padding: {{ section.settings.padding_top_desktop }}px 136px {{ section.settings.padding_bottom_desktop }}px;
      align-items: center;
    }
  }

  .leadspace-{{ section.id }} .ls-cover-only {
    width: 100%;
    min-height: 704px;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-cover-only {
      min-height: 876px;
    }
  }

  .leadspace-{{ section.id }} .ls-card {
    background-color: #102116;
    border-radius: 25px;
    width: 100%;
    max-width: 331px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 584px;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-card {
      border-radius: 20px;
      max-width: 1168px;
      min-height: 634px;
      flex-direction: row;
      align-items: flex-end;
      overflow: visible;
    }
  }

  .leadspace-{{ section.id }} .ls-text {
    flex: 1;
    color: #ffffff;
    padding: 16px 16px 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    z-index: 2;
    order: 1;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-text {
      padding: 40px 0 40px 48px;
      justify-content: flex-end;
      order: 1;
    }
  }

  .leadspace-{{ section.id }} .ls-heading {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 68px;
    font-weight: 700;
    font-stretch: condensed;
    text-transform: uppercase;
    line-height: 0.92;
    margin: 0 0 14px 0;
    color: #ffffff;
    letter-spacing: -1px;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-heading {
      font-size: 120px;
      line-height: 0.92;
      margin: 0 0 24px 0;
    }
  }

  .leadspace-{{ section.id }} .ls-desc {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: #ffffff;
    margin: 0 0 0 0;
    max-width: 280px;
    order: 2;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-desc {
      font-size: 20px;
      line-height: 1.4;
      max-width: 380px;
      margin: 0 0 32px 0;
    }
  }

  .leadspace-{{ section.id }} .ls-btn {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: #ffffff;
      color: #000000;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-weight: 700;
      font-size: 18px;
      height: 82px;
      width: 351px;
      border-radius: 56px;
      text-decoration: none;
      box-shadow: 4px 8px 12px 0px rgba(0, 0, 0, 0.25);
      transition: background-color 0.2s ease;
      flex-shrink: 0;
      order: 3;
    }
  }

  .leadspace-{{ section.id }} .ls-btn:hover {
    background-color: #f0f0f0;
  }

  .leadspace-{{ section.id }} .ls-image-wrap {
    position: relative;
    width: 100%;
    height: 340px;
    overflow: hidden;
    flex-shrink: 0;
    order: 3;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-image-wrap {
      position: static;
      width: 460px;
      height: 700px;
      overflow: visible;
      align-self: flex-end;
      flex-shrink: 0;
      order: 2;
      margin-bottom: -1px;
    }
  }

  .leadspace-{{ section.id }} .ls-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-image-wrap img {
      object-fit: contain;
      object-position: bottom center;
    }
  }

  .leadspace-{{ section.id }} .ls-btn-overlay {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    color: #000000;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-size: 15px;
    height: 73px;
    width: 229px;
    border-radius: 56px;
    text-decoration: none;
    box-shadow: 4px 8px 12px 0px rgba(0, 0, 0, 0.25);
    transition: background-color 0.2s ease;
    z-index: 3;
    white-space: nowrap;
  }

  .leadspace-{{ section.id }} .ls-btn-overlay:hover {
    background-color: #f0f0f0;
  }

  @media screen and (min-width: 768px) {
    .leadspace-{{ section.id }} .ls-btn-overlay {
      display: none;
    }
  }
{%- endstyle -%}

<section class="leadspace-{{ section.id }}">
  {%- if section.settings.cover_image_desktop != blank or section.settings.cover_image_mobile != blank -%}
    <div class="ls-bg-photo">
      <picture>
        {%- if section.settings.cover_image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.cover_image_mobile | image_url: width: 800 }}">
        {%- endif -%}
        {%- if section.settings.cover_image_desktop != blank -%}
          <source
            media="(min-width: 768px)"
            srcset="{{ section.settings.cover_image_desktop | image_url: width: 1600 }}"
          >
        {%- elsif section.settings.cover_image_mobile != blank -%}
          <source
            media="(min-width: 768px)"
            srcset="{{ section.settings.cover_image_mobile | image_url: width: 1600 }}"
          >
        {%- endif -%}
        {{
          section.settings.cover_image_desktop
          | default: section.settings.cover_image_mobile
          | image_url: width: 1600
          | image_tag: loading: 'eager', alt: 'Background'
        }}
      </picture>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="ls-content">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="ls-card" {{ block.shopify_attributes }}>
            <div class="ls-text">
              {%- if block.settings.title != blank -%}
                <h2 class="ls-heading">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ls-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
                <a href="{{ block.settings.cta_link }}" class="ls-btn">{{ block.settings.cta_text }}</a>
              {%- endif -%}
            </div>
            {%- if block.settings.card_image != blank -%}
              <div class="ls-image-wrap">
                {{
                  block.settings.card_image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', alt: block.settings.title
                }}
                {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
                  <a href="{{ block.settings.cta_link }}" class="ls-btn-overlay">{{ block.settings.cta_text }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="ls-cover-only"></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Leadspace Trends",
  "settings": [
    {
      "type": "image_picker",
      "id": "cover_image_desktop",
      "label": "Cover Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "cover_image_mobile",
      "label": "Cover Image (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "FALL TRENDS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet. In architecto recusandae et odio quisquam quo corporis."
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Leadspace Trends",
      "blocks": [{ "type": "card" }]
    }
  ]
}
{% endschema %}
