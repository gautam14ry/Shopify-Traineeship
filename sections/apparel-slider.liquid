{%- style -%}
  .section-space-{{ section.id }} {
    background-color: #FFEDDD;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .section-space-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .apparel-slider-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .apparel-slider-inner-box {
    background-color: #A07636;
    border-radius: 28px;
    padding: 32px 16px;
    position: relative;
  }

  @media screen and (min-width: 768px) {
    .apparel-slider-inner-box {
      padding: 48px 40px;
    }
  }

  .apparel-slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .apparel-slider-heading {
    color: #ffffff;
    font-size: 24px;
    font-weight: 700;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .apparel-slider-heading {
      font-size: 32px;
    }
  }

  .apparel-slider-nav {
    display: flex;
    gap: 8px;
  }

  .apparel-slider-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    padding: 0;
  }

  .apparel-slider-arrow:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .apparel-slider-arrow svg {
    width: 16px;
    height: 16px;
    fill: #000000;
  }

  .apparel-layout-engine {
    display: flex;
    gap: 16px;
    width: 100%;
  }

  .apparel-layout-engine.layout-static-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media screen and (min-width: 480px) {
    .apparel-layout-engine.layout-static-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 992px) {
    .apparel-layout-engine.layout-static-grid {
      grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
    }
  }

  .apparel-layout-engine.layout-fluid-slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .apparel-layout-engine.layout-fluid-slider::-webkit-scrollbar {
    display: none;
  }

  .custom-slider-card-wrapper {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    overflow: hidden;
    text-decoration: none;
    color: #000000;
  }

  .apparel-layout-engine.layout-fluid-slider .custom-slider-card-wrapper {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 576px) {
    .apparel-layout-engine.layout-fluid-slider .custom-slider-card-wrapper {
      flex: 0 0 45%;
    }
  }

  @media screen and (min-width: 992px) {
    .apparel-layout-engine.layout-fluid-slider .custom-slider-card-wrapper {
      flex: 0 0 calc(25% - 12px);
    }
  }

  .custom-slider-card-media {
    width: 100%;
    overflow: hidden;
    background-color: #f7f7f7;
    display: block;
  }

 .custom-slider-card-img {
    width: 100%;
    height: auto;     
    display: block;
    object-fit: contain; 
  }

  .custom-slider-card-placeholder {
    width: 100%;
    height: 100%;
  }

  .custom-slider-card-info {
    padding: 16px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .custom-slider-card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .custom-slider-card-tag {
    font-size: 12px;
    color: #6B7280;
    text-transform: uppercase;
  }

  .custom-slider-card-price {
    font-size: 14px;
    font-weight: 700;
  }

  .custom-slider-card-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
{%- endstyle -%}

<section class="section-space-{{ section.id }}">
  <div class="apparel-slider-container">
    <div class="apparel-slider-inner-box">
      
      <div class="apparel-slider-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="apparel-slider-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 4 -%}
          <div class="apparel-slider-nav">
            <button class="apparel-slider-arrow btn-prev-{{ section.id }}" aria-label="Previous" disabled>
              <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
            <button class="apparel-slider-arrow btn-next-{{ section.id }}" aria-label="Next">
              <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <div 
        id="LayoutEngine-{{ section.id }}"
        class="apparel-layout-engine {% if section.blocks.size > 4 %}layout-fluid-slider{% else %}layout-static-grid{% endif %}"
      >
        {%- for block in section.blocks -%}
          {%- render 'slider-card', block: block -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{%- if section.blocks.size > 4 -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('LayoutEngine-{{ section.id }}');
    const prevBtn = document.querySelector('.btn-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.btn-next-{{ section.id }}');
    
    if (!track || !prevBtn || !nextBtn) return;

    function getScrollStep() {
      const firstCard = track.querySelector('.custom-slider-card-wrapper');
      return firstCard ? firstCard.offsetWidth + 16 : track.offsetWidth;
    }

    nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', function() {
      prevBtn.disabled = track.scrollLeft <= 5;
      const maxScroll = track.scrollWidth - track.clientWidth;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Apparel Slider",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Tailgate Apparel"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$45"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Primary Basics Collection Tee"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apparel Slider Section",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}