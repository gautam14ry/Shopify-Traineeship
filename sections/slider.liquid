{%- liquid
  assign section_class = 'slider-' | append: section.id
  assign heading = section.settings.heading
  assign card_blocks = section.blocks | where: 'type', 'card'
  assign legacy_slider_cards = section.blocks | where: 'type', 'slidercard'
  assign cards = card_blocks | concat: legacy_slider_cards
  assign card_count = cards.size
  assign is_slider = false
  if card_count > 4
    assign is_slider = true
  endif
-%}

{%- style -%}
  .{{ section_class }} {
    background-color: #FFEDDD;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .{{ section_class }} .as-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }} .as-wrap {
      padding: 0 40px;
    }
  }

  .{{ section_class }} .as-title-outside {
    display: block;
    color: #000000;
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 16px 0;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }} .as-title-outside {
      display: none;
    }
  }

  .{{ section_class }} .as-box {
    background: transparent;
    padding: 0;
    overflow: visible;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }} .as-box {
      background-color: #a07636;
      border-radius: 25px;
      padding: 40px 16px;
    }
  }

  .{{ section_class }} .as-header {
    display: none;
    position: relative;
    z-index: 3;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }} .as-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding: 0 8px;
    }
  }

  .{{ section_class }} .as-title {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
    margin: 0;
  }

  .{{ section_class }} .as-arrows {
    display: flex;
    gap: 8px;
  }

  .{{ section_class }} .as-arrow {
    width: 36px;
    height: 36px;
    border-radius: 1000px;
    background: #ffffff !important;
    border: none !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
    flex-shrink: 0;
    padding: 0;
    position: relative;
    z-index: 2;
    -webkit-appearance: none;
    appearance: none;
  }

  .{{ section_class }} .as-arrow svg {
    display: block;
  }

  .{{ section_class }} .as-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .{{ section_class }} .as-track {
    width: 100%;
  }

  .{{ section_class }}.as-mode-slider .as-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  .{{ section_class }}.as-mode-slider .as-track::-webkit-scrollbar {
    display: none;
  }

  .{{ section_class }}.as-mode-slider .as-track .as-card {
    flex: 0 0 85%;
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 768px) {
    .{{ section_class }}.as-mode-slider .as-track {
      gap: 24px;
    }
  }

  @media screen and (min-width: 992px) {
    .{{ section_class }}.as-mode-slider .as-track .as-card {
      flex: 0 0 calc(25% - 18px);
    }
  }

  .{{ section_class }}.as-mode-grid .as-track {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  @media screen and (min-width: 480px) {
    .{{ section_class }}.as-mode-grid .as-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 992px) {
    .{{ section_class }}.as-mode-grid .as-track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .{{ section_class }} .as-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    overflow: hidden;
    text-decoration: none;
    color: #000000;
    border-radius: 4px;
  }

  .{{ section_class }} .as-card-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #f5f5f5;
    overflow: hidden;
  }

  .{{ section_class }} .as-card-img img,
  .{{ section_class }} .as-card-img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .{{ section_class }} .as-card-info {
    padding: 14px 14px 16px;
  }

  .{{ section_class }} .as-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    margin-bottom: 8px;
  }

  .{{ section_class }} .as-card-tag {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .{{ section_class }} .as-card-price {
    font-size: 14px;
    font-weight: 700;
  }

  .{{ section_class }} .as-card-title {
    margin: 0;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 400;
  }
{%- endstyle -%}

<section class="{{ section_class }}{% if is_slider %} as-mode-slider{% else %} as-mode-grid{% endif %}">
  <div class="as-wrap">
    {%- if heading != blank -%}
      <h2 class="as-title-outside">{{ heading }}</h2>
    {%- endif -%}

    <div class="as-box">
      <div class="as-header">
        {%- if heading != blank -%}
          <h2 class="as-title">{{ heading }}</h2>
        {%- endif -%}

        {%- if is_slider -%}
        <div class="as-arrows">
          <button type="button" class="as-arrow as-prev-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.5 13L5.5 8L10.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="as-arrow as-next-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5.5 3L10.5 8L5.5 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        {%- endif -%}
      </div>

      <div class="as-track" id="as-track-{{ section.id }}">
        {%- for block in cards -%}
          {%- render 'slider-card', block: block -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if is_slider -%}
    <script>
      (function () {
        function initSlider() {
          var track = document.getElementById('as-track-{{ section.id }}');
          var prev = document.querySelector('.as-prev-{{ section.id }}');
          var next = document.querySelector('.as-next-{{ section.id }}');
          if (!track || !prev || !next) return;

          function gap() {
            var style = window.getComputedStyle(track);
            var value = parseFloat(style.columnGap || style.gap || '0');
            return Number.isFinite(value) && value > 0 ? value : 24;
          }

          function step() {
            var card = track.querySelector('.as-card');
            return card ? card.offsetWidth + gap() : track.clientWidth;
          }

          function updateArrows() {
            prev.disabled = track.scrollLeft <= 5;
            next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
          }

          next.addEventListener('click', function () {
            track.scrollBy({ left: step(), behavior: 'smooth' });
          });
          prev.addEventListener('click', function () {
            track.scrollBy({ left: -step(), behavior: 'smooth' });
          });
          track.addEventListener('scroll', updateArrows);
          updateArrows();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSlider);
        } else {
          initSlider();
        }
      })();
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tailgate Apparel"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$45"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card Link"
        }
      ]
    },
    {
      "type": "slidercard",
      "name": "Card (Legacy)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "New Arrival"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$45"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
